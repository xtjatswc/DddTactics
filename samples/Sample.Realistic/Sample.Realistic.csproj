<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <EnableDddTacticsTopology>true</EnableDddTacticsTopology>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DddTactics.Core\DddTactics.Core.csproj" />
    <ProjectReference Include="..\..\src\DddTactics.EFCore\DddTactics.EFCore.csproj" />
    <ProjectReference Include="..\..\src\DddTactics.Topology\DddTactics.Topology.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.0" />
    <!-- 拓扑源生成器与分析器（分析器不沿 ProjectReference 传递，需消费方直接引用） -->
    <ProjectReference Include="..\..\src\DddTactics.Topology.Generator\DddTactics.Topology.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\DddTactics.Analyzers\DddTactics.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
